#!/bin/sh
# Patch the local Antigravity proxy checkout to recognize the gpt-oss model
# family, so models like gpt-oss-120b-medium pass through getModelFamily() and
# isSupportedModel() instead of being rejected as "unknown".
#
# This is a one-line minimum patch over the third-party
# badrisnarayanan/antigravity-claude-proxy codebase. It is idempotent: if the
# patch is already applied (the gpt-oss family line is present), the script
# exits 0 without touching anything.
#
# Usage:
#   antigravity-proxy-patch                       # auto-detect proxy dir
#   antigravity-proxy-patch --proxy-dir <path>    # explicit path
#   antigravity-proxy-patch --status             # just report whether patched
#   antigravity-proxy-patch --revert             # remove the patch (best effort)
#
# The proxy is auto-detected in this order:
#   1. --proxy-dir argument or $ANTIGRAVITY_PROXY_DIR env
#   2. $ROOT_DIR/antigravity-claude-proxy (sibling of crouter, default install layout)
#
# Exit codes:
#   0  patch applied (or already applied)
#   1  proxy directory not found
#   2  proxy directory found but doesn't look like the right project
#   3  patch command failed
#   4  revert requested but patch isn't present
set -u

SELF=$0
while [ -h "$SELF" ]; do
  _d=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
  _l=$(readlink "$SELF")
  case $_l in
    /*) SELF=$_l ;;
    *)  SELF=$_d/$_l ;;
  esac
done
ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")/.." && pwd)

PROXY_DIR=""
MODE="apply"
while [ $# -gt 0 ]; do
  case "$1" in
    --proxy-dir) [ $# -ge 2 ] || { echo "antigravity-proxy-patch: --proxy-dir needs an argument" >&2; exit 1; }
                 PROXY_DIR=$2; shift 2 ;;
    --proxy-dir=*) PROXY_DIR=${1#--proxy-dir=}; shift ;;
    --status) MODE="status"; shift ;;
    --revert) MODE="revert"; shift ;;
    -h|--help)
      sed -n '2,23p' "$SELF" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *) echo "antigravity-proxy-patch: unknown argument '$1'" >&2; exit 1 ;;
  esac
done

# Honor env override used by providers/antigravity*.sh via config.sh.
[ -n "$PROXY_DIR" ] || PROXY_DIR=${ANTIGRAVITY_PROXY_DIR:-}
[ -n "$PROXY_DIR" ] || PROXY_DIR="$ROOT_DIR/antigravity-claude-proxy"

PROXY_DIR=$(CDPATH= cd -- "$PROXY_DIR" 2>/dev/null && pwd) || {
  echo "antigravity-proxy-patch: proxy directory not found: $PROXY_DIR" >&2
  echo "  set --proxy-dir <path> or ANTIGRAVITY_PROXY_DIR in config.sh" >&2
  exit 1
}

CONSTANTS="$PROXY_DIR/src/constants.js"
MODEL_API="$PROXY_DIR/src/cloudcode/model-api.js"

# Sanity-check this looks like the antigravity proxy checkout.
if [ ! -f "$CONSTANTS" ] || [ ! -f "$MODEL_API" ]; then
  echo "antigravity-proxy-patch: $PROXY_DIR doesn't look like antigravity-claude-proxy" >&2
  echo "  expected $CONSTANTS and $MODEL_API" >&2
  exit 2
fi

# Idempotency probe: search the constants.js source for the patched line.
case "$MODE" in
  status)
    if grep -qF "gpt-oss" "$CONSTANTS" 2>/dev/null; then
      echo "antigravity-proxy-patch: GPT-OSS support IS applied at $PROXY_DIR"
    else
      echo "antigravity-proxy-patch: GPT-OSS support NOT applied at $PROXY_DIR"
    fi
    exit 0
    ;;

  revert)
    if ! grep -qF "gpt-oss" "$CONSTANTS" 2>/dev/null; then
      echo "antigravity-proxy-patch: GPT-OSS patch is not present; nothing to revert" >&2
      exit 4
    fi
    # Drop the gpt-oss line from constants.js and restore the two-family check
    # in model-api.js. Use '#' as the sed s-command delimiter so the '||' in
    # the pattern doesn't trip BSD sed on macOS.
    _rc=0
    sed -i.bak "/if (lower.includes('gpt-oss'))/d" "$CONSTANTS" || _rc=$?
    sed -i.bak "s#return family === 'claude' || family === 'gemini' || family === 'gpt-oss';#return family === 'claude' || family === 'gemini';#" "$MODEL_API" || _rc=$?
    rm -f "$CONSTANTS.bak" "$MODEL_API.bak"
    if [ "$_rc" -ne 0 ]; then
      echo "antigravity-proxy-patch: revert failed at $PROXY_DIR (sed rc=$_rc)" >&2
      exit 3
    fi
    echo "antigravity-proxy-patch: reverted GPT-OSS patch at $PROXY_DIR"
    exit 0
    ;;

  apply)
    if grep -qF "gpt-oss" "$CONSTANTS" 2>/dev/null; then
      echo "antigravity-proxy-patch: already patched at $PROXY_DIR (no-op)"
      exit 0
    fi

    # Two targeted insertions via sed:
    #   constants.js: add 'if (lower.includes('gpt-oss')) return 'gpt-oss';'
    #                 immediately after the existing gemini line.
    #   model-api.js: extend isSupportedModel to also allow 'gpt-oss'.
    _rc=0
    sed -i.bak "/if (lower.includes('gemini')) return 'gemini';/a\\
    if (lower.includes('gpt-oss')) return 'gpt-oss';" "$CONSTANTS" || _rc=$?

    sed -i.bak "s#return family === 'claude' || family === 'gemini';#return family === 'claude' || family === 'gemini' || family === 'gpt-oss';#" "$MODEL_API" || _rc=$?

    # Sanity: confirm the patch landed. If sed silently no-op'd (BSD/GNU
    # differences, missing newline at pattern site), report and roll back.
    if [ "$_rc" -ne 0 ] || ! grep -qF "gpt-oss" "$CONSTANTS" 2>/dev/null; then
      mv "$CONSTANTS.bak" "$CONSTANTS" 2>/dev/null
      mv "$MODEL_API.bak"  "$MODEL_API"  2>/dev/null
      echo "antigravity-proxy-patch: patch failed to land at $PROXY_DIR (sed rc=$_rc)" >&2
      echo "  files restored from .bak; please apply manually" >&2
      exit 3
    fi
    rm -f "$CONSTANTS.bak" "$MODEL_API.bak"

    echo "antigravity-proxy-patch: applied GPT-OSS family patch at $PROXY_DIR"
    echo "  $CONSTANTS"
    echo "  $MODEL_API"
    echo "  (run '$0 --status' to verify; --revert to remove)"
    exit 0
    ;;
esac