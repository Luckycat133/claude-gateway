#!/bin/sh
# claude-gateway - unified launcher for Claude Code against multiple providers.
#
# Usage:
#   claude-gateway <provider> [claude args...]   Launch Claude Code via a provider
#   claude-gateway run <provider> [args...]      Same as above, explicit form
#   claude-gateway list                          List available providers
#   claude-gateway status [provider]             Show auth/health status
#   claude-gateway doctor [provider]             Run environment diagnostics
#   claude-gateway start <provider>              Run the provider's PRE_START hook only
#   claude-gateway stop <provider>               Run the provider's POST_STOP hook only
#   claude-gateway forget <provider>             Forget the remembered last-used model
#   claude-gateway help                          Show this help
#   claude-gateway --version                     Show version
#
# Providers live in providers/<name>.sh and only declare "how to connect".
# This entry point owns "how to launch safely and portably".

set -u

# ---------------------------------------------------------------------------
# Locate ourselves (follow symlinks so a ~/.local/bin link still finds ROOT_DIR)
# ---------------------------------------------------------------------------
SELF=$0
while [ -h "$SELF" ]; do
  self_dir=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
  link=$(readlink "$SELF")
  case $link in
    /*) SELF=$link ;;
    *)  SELF=$self_dir/$link ;;
  esac
done
BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
ROOT_DIR=$(CDPATH= cd -- "$BIN_DIR/.." && pwd)
PROVIDERS_DIR=$ROOT_DIR/providers

# ---------------------------------------------------------------------------
# Version (single source of truth: $ROOT_DIR/VERSION)
# ---------------------------------------------------------------------------
VERSION=$(cat "$ROOT_DIR/VERSION" 2>/dev/null || printf 'unknown')

# ---------------------------------------------------------------------------
# Config (optional, gitignored). config.example.sh documents the knobs.
# ---------------------------------------------------------------------------
CLAUDE_BIN=${CLAUDE_BIN:-}
LOG_DIR=${LOG_DIR:-$ROOT_DIR/logs}
STATE_DIR=${STATE_DIR:-$ROOT_DIR/.state}
if [ -f "$ROOT_DIR/config.sh" ]; then
  . "$ROOT_DIR/config.sh"
fi
if [ -z "$CLAUDE_BIN" ]; then
  CLAUDE_BIN=$(command -v claude 2>/dev/null || true)
fi
NODE_BIN=${NODE_BIN:-$(command -v node 2>/dev/null || true)}

die() { printf 'claude-gateway: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }

usage() {
  sed -n '2,16p' "$SELF" | sed 's/^# \{0,1\}//'
}

# ---------------------------------------------------------------------------
# Provider loading
# ---------------------------------------------------------------------------
provider_file() { printf '%s/%s.sh' "$PROVIDERS_DIR" "$1"; }

provider_names() {
  for f in "$PROVIDERS_DIR"/*.sh; do
    [ -f "$f" ] || continue
    basename "$f" .sh
  done
}

load_provider() {
  _name=$1
  _file=$(provider_file "$_name")
  [ -f "$_file" ] || die "unknown provider '$_name' (try: claude-gateway list)"

  # Reset the provider contract before sourcing.
  PROVIDER_NAME= PROVIDER_DESC= BASE_URL= MODEL=
  MODEL_OPUS= MODEL_SONNET= MODEL_HAIKU= MODEL_SUBAGENT=
  CONTEXT_TOKENS= AUTH_MODE=none AUTH_REFERENCE=
  EXTRA_ENV= PRE_START= POST_STOP= HEALTH_CHECK_URL=

  . "$_file"

  PROVIDER_NAME=${PROVIDER_NAME:-$_name}
  [ -n "$BASE_URL" ] || die "provider '$_name': BASE_URL is required"
  [ -n "$MODEL" ]    || die "provider '$_name': MODEL is required"
  MODEL_OPUS=${MODEL_OPUS:-$MODEL}
  MODEL_SONNET=${MODEL_SONNET:-$MODEL}
  MODEL_HAIKU=${MODEL_HAIKU:-$MODEL}
  MODEL_SUBAGENT=${MODEL_SUBAGENT:-$MODEL_HAIKU}
}

# ---------------------------------------------------------------------------
# Auth. The secret only ever lives in AUTH_TOKEN inside this process.
# ---------------------------------------------------------------------------
# Keychain availability cache (disk-backed): avoids repeating `security` lookups.
_kc_cache_dir() { printf '%s/.kc-cache' "${LOG_DIR:-$ROOT_DIR/logs}"; }
_kc_state() {
  _d=$(_kc_cache_dir)
  _f="$_d/$1"
  [ -f "$_f" ] && cat "$_f" 2>/dev/null
  return 0
}
_kc_set_state() {
  mkdir -p "$(_kc_cache_dir)" 2>/dev/null
  printf '%s' "$2" > "$(_kc_cache_dir)/$1" 2>/dev/null
}

# ---------------------------------------------------------------------------
# Last-used model memory (per provider). A provider defaults to the model the
# user picked last launch instead of the hard-coded MODEL every time. Only the
# *primary* model is remembered; in-session /model switches happen inside Claude
# Code and are invisible to the gateway.
# ---------------------------------------------------------------------------
_lm_file() { printf '%s/last-model/%s' "${STATE_DIR:-$ROOT_DIR/.state}" "$1"; }
load_last_model() {
  _f=$(_lm_file "$1"); [ -f "$_f" ] && cat "$_f" 2>/dev/null; return 0
}
save_last_model() {
  _d="${STATE_DIR:-$ROOT_DIR/.state}/last-model"
  mkdir -p "$_d" 2>/dev/null
  printf '%s' "$2" > "$_d/$1" 2>/dev/null
}
forget_last_model() {
  _f=$(_lm_file "$1"); [ -f "$_f" ] && rm -f "$_f"
}

resolve_auth() {
  AUTH_TOKEN=
  case $AUTH_MODE in
    keychain)
      AUTH_TOKEN=$(security find-generic-password -a "$USER" -s "$AUTH_REFERENCE" -w 2>/dev/null)
      [ -n "$AUTH_TOKEN" ] || die "keychain item '$AUTH_REFERENCE' not found (provider '$PROVIDER_NAME')"
      ;;
    env)
      AUTH_TOKEN=$(printenv "$AUTH_REFERENCE" 2>/dev/null)
      [ -n "$AUTH_TOKEN" ] || die "environment variable '$AUTH_REFERENCE' is empty (provider '$PROVIDER_NAME')"
      ;;
    command)
      AUTH_TOKEN=$(eval "$AUTH_REFERENCE") ||
        die "auth command failed (provider '$PROVIDER_NAME')"
      [ -n "$AUTH_TOKEN" ] || die "auth command returned empty output (provider '$PROVIDER_NAME')"
      ;;
    static)
      AUTH_TOKEN=$AUTH_REFERENCE
      ;;
    none)
      ;;
    *)
      die "provider '$PROVIDER_NAME': unsupported AUTH_MODE '$AUTH_MODE'"
      ;;
  esac
}

# keypool: resolve a pool of keys from keychain, start a local key-failover proxy,
# and expose its URL. Claude Code then talks to the proxy, which rotates keys on
# 429/401 so quota exhaustion is handled transparently (mid-session).
start_keypool() {
  [ -n "$NODE_BIN" ] || die "node not found; keypool proxy cannot start"
  [ -n "${AUTH_KEYS:-}" ] || die "provider '$PROVIDER_NAME': AUTH_MODE=keypool requires AUTH_KEYS"

  _pool=""
  for _ref in $AUTH_KEYS; do
    _t=$(security find-generic-password -a "$USER" -s "$_ref" -w 2>/dev/null)
    [ -n "$_t" ] || die "keychain item '$_ref' not found (provider '$PROVIDER_NAME')"
    _pool="$_pool $_t"
  done

  _targets="$BASE_URL"
  if [ -n "${CODING_BASE_URL:-}" ]; then
    _targets="$_targets;$CODING_BASE_URL"
    if [ -n "${CODING_KEYS:-}" ]; then
      for _ref in $CODING_KEYS; do
        _t=$(security find-generic-password -a "$USER" -s "$_ref" -w 2>/dev/null)
        [ -n "$_t" ] || die "keychain item '$_ref' not found (provider '$PROVIDER_NAME')"
        _pool="$_pool $_t"
      done
    fi
  fi
  _pool=$(echo "$_pool" | sed 's/^ *//; s/ *$//')

  _out=$(mktemp -t keypool.XXXXXX)
  KEYPOOL_KEYS="$_pool" KEYPOOL_TARGETS="$_targets" KEYPOOL_PORT=0 \
    "$NODE_BIN" "$BIN_DIR/keypool-proxy" > "$_out" 2>/dev/null &
  KEYPOOL_PID=$!

  _lp=""
  _i=0
  while [ $_i -lt 30 ]; do
    _lp=$(grep -m1 '^KEYPOOL_LISTENING_PORT=' "$_out" 2>/dev/null | cut -d= -f2)
    [ -n "$_lp" ] && break
    sleep 0.1
    _i=$((_i + 1))
  done
  rm -f "$_out"
  if [ -z "$_lp" ]; then
    kill "$KEYPOOL_PID" 2>/dev/null
    die "keypool proxy failed to start (provider '$PROVIDER_NAME')"
  fi
  KEYPOOL_URL="http://127.0.0.1:$_lp"
  export KEYPOOL_URL KEYPOOL_PID
  info "keypool: proxy on $KEYPOOL_URL ($(echo "$_pool" | wc -w | tr -d ' ') keys, $(echo "$_targets" | tr ';' '\n' | wc -l | tr -d ' ') surfaces)"
}

# Non-destructive availability check used by status/doctor (never prints secrets).
check_auth() {
  case $AUTH_MODE in
    keychain)
      _st=$(_kc_state "$AUTH_REFERENCE")
      if [ -z "$_st" ]; then
        if security find-generic-password -a "$USER" -s "$AUTH_REFERENCE" >/dev/null 2>&1; then
          _st=ok
        else
          _st=missing
        fi
        _kc_set_state "$AUTH_REFERENCE" "$_st"
      fi
      [ "$_st" = ok ]
      ;;
    env)
      _v=$(printenv "$AUTH_REFERENCE" 2>/dev/null); [ -n "$_v" ] ;;
    command)
      _v=$(eval "$AUTH_REFERENCE" 2>/dev/null) && [ -n "$_v" ] ;;
    static|none)
      true ;;
    keypool)
      _ok=0
      for _ref in ${AUTH_KEYS:-}; do
        if security find-generic-password -a "$USER" -s "$_ref" >/dev/null 2>&1; then _ok=1; break; fi
      done
      [ "$_ok" -eq 1 ] ;;
    *)
      false ;;
  esac
}

check_health() {
  [ -n "$HEALTH_CHECK_URL" ] || return 2
  curl -fsS --max-time 3 "$HEALTH_CHECK_URL" >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# Hooks
# ---------------------------------------------------------------------------
run_pre_start() {
  [ -n "$PRE_START" ] || return 0
  eval "$PRE_START" || die "PRE_START hook failed for '$PROVIDER_NAME'"
}

run_post_stop() {
  [ -n "$POST_STOP" ] || { info "provider '$PROVIDER_NAME' has no POST_STOP hook."; return 0; }
  eval "$POST_STOP"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
cmd_run() {
  _p=$1; shift
  load_provider "$_p"

  # Resolve the primary model with this precedence:
  #   --model <x>  >  ANTHROPIC_MODEL env  >  remembered model  >  provider MODEL
  # Any explicit choice is remembered for the next launch. Only the primary
  # model is tracked; in-session /model switches live inside Claude Code and
  # are invisible to the gateway.
  _main_model=""
  _model_set=0
  _i=0
  while [ $_i -lt $# ]; do
    _i=$((_i + 1))
    eval "_a=\${$_i}"
    case "$_a" in
      --model=*) _main_model=${_a#--model=}; _model_set=1 ;;
      --model)
        _i=$((_i + 1))
        eval "_main_model=\${$_i}"; _model_set=1
        ;;
    esac
  done
  if [ "$_model_set" -eq 1 ] && [ -n "$_main_model" ]; then
    save_last_model "$_p" "$_main_model"
  elif [ -n "${ANTHROPIC_MODEL:-}" ]; then
    _main_model=$ANTHROPIC_MODEL
    save_last_model "$_p" "$_main_model"
  else
    _main_model=$(load_last_model "$_p")
    [ -z "$_main_model" ] && _main_model=$MODEL
  fi

  AUTH_TOKEN=""
  _bypass_auth=0
  for _arg in "$@"; do
    case "$_arg" in
      --version|-V|--help|-h) _bypass_auth=1 ;;
    esac
  done

  if [ "$_bypass_auth" -eq 0 ]; then
    run_pre_start
    if [ "${AUTH_MODE:-}" = "keypool" ]; then
      start_keypool
    else
      resolve_auth
    fi
  fi

  [ -n "$CLAUDE_BIN" ] || die "claude binary not found; set CLAUDE_BIN in config.sh"
  [ -x "$CLAUDE_BIN" ] || die "claude binary is not executable: $CLAUDE_BIN"

  # Build "env -i KEY=VAL ... claude args..." via positional parameters so
  # values with spaces survive. Everything is prepended in front of "$@".
  set -- "$CLAUDE_BIN" "$@"

  if [ -n "$EXTRA_ENV" ]; then
    _old_ifs=$IFS
    IFS='
'
    for _pair in $EXTRA_ENV; do
      [ -n "$_pair" ] && set -- "$_pair" "$@"
    done
    IFS=$_old_ifs
  fi

  # Model aliases; caller may override any of them per session.
  set -- "CLAUDE_CODE_SUBAGENT_MODEL=${CLAUDE_CODE_SUBAGENT_MODEL:-$MODEL_SUBAGENT}" "$@"
  set -- "ANTHROPIC_DEFAULT_HAIKU_MODEL=${ANTHROPIC_DEFAULT_HAIKU_MODEL:-$MODEL_HAIKU}" "$@"
  set -- "ANTHROPIC_DEFAULT_SONNET_MODEL=${ANTHROPIC_DEFAULT_SONNET_MODEL:-$MODEL_SONNET}" "$@"
  set -- "ANTHROPIC_DEFAULT_OPUS_MODEL=${ANTHROPIC_DEFAULT_OPUS_MODEL:-$MODEL_OPUS}" "$@"
  set -- "ANTHROPIC_MODEL=$_main_model" "$@"
  [ -n "$CONTEXT_TOKENS" ] && set -- "CLAUDE_CODE_MAX_CONTEXT_TOKENS=$CONTEXT_TOKENS" "$@"

  if [ "${AUTH_MODE:-}" = "keypool" ]; then
    [ -n "${KEYPOOL_URL:-}" ] || die "keypool proxy not started"
    set -- "ANTHROPIC_BASE_URL=$KEYPOOL_URL" "$@"
    set -- "ANTHROPIC_API_KEY=keypool-local" "$@"
    set -- "ANTHROPIC_AUTH_TOKEN=keypool-local" "$@"
  elif [ -n "$AUTH_TOKEN" ]; then
    set -- "ANTHROPIC_API_KEY=$AUTH_TOKEN" "$@"
    set -- "ANTHROPIC_AUTH_TOKEN=$AUTH_TOKEN" "$@"
  fi
  set -- "ANTHROPIC_BASE_URL=${KEYPOOL_URL:-$BASE_URL}" "$@"

  # Minimal, terminal-safe environment. No shell leftovers (NO_COLOR etc.).
  set -- "LANG=${LANG:-en_US.UTF-8}" "$@"
  set -- "COLORTERM=${COLORTERM:-truecolor}" "$@"
  set -- "TERM=${TERM:-xterm-256color}" "$@"
  set -- "SHELL=${SHELL:-/bin/zsh}" "$@"
  set -- "PATH=$PATH" "$@"
  set -- "USER=$USER" "$@"
  set -- "HOME=$HOME" "$@"

  if [ "${AUTH_MODE:-}" = "keypool" ]; then
    # Run as a child (not exec) so we can reap the proxy on exit.
    env -i "$@" &
    _cg_pid=$!
    trap 'kill "$KEYPOOL_PID" 2>/dev/null; kill "$_cg_pid" 2>/dev/null' EXIT INT TERM
    wait "$_cg_pid"
    _rc=$?
    kill "$KEYPOOL_PID" 2>/dev/null
    exit "${_rc:-0}"
  fi
  exec env -i "$@"
}

cmd_list() {
  printf '%-22s %-26s %-11s %s\n' 'PROVIDER' 'DEFAULT MODEL' 'AUTH' 'ENDPOINT'
  for _n in $(provider_names); do
    (
      load_provider "$_n"
      printf '%-22s %-26s %-11s %s\n' "$_n" "$MODEL" "$AUTH_MODE" "$BASE_URL"
    )
  done
}

status_one() {
  (
    load_provider "$1"
    if check_auth; then _auth=ok; else _auth=MISSING; fi
    if [ -n "$HEALTH_CHECK_URL" ]; then
      if check_health; then _health=up; else _health=DOWN; fi
    else
      _health='-'
    fi
    printf '%-22s auth:%-9s health:%-6s %s\n' "$1" "$_auth" "$_health" "$BASE_URL"
    _lm=$(load_last_model "$1")
    if [ -n "$_lm" ]; then printf '%-22s last model: %s\n' "" "$_lm"; fi
  )
}

cmd_status() {
  if [ -n "${1:-}" ]; then
    status_one "$1"
  else
    for _n in $(provider_names); do status_one "$_n"; done
  fi
}

cmd_doctor() {
  _fail=0

  if [ -n "$CLAUDE_BIN" ] && [ -x "$CLAUDE_BIN" ]; then
    info "ok    claude binary: $CLAUDE_BIN"
  else
    info "FAIL  claude binary not found (set CLAUDE_BIN in config.sh)"; _fail=1
  fi

  if [ -f "$ROOT_DIR/config.sh" ]; then
    info "ok    config: $ROOT_DIR/config.sh"
  else
    info "note  no config.sh (using defaults; copy config.example.sh if needed)"
  fi

  if command -v curl >/dev/null 2>&1; then
    info "ok    curl available"
  else
    info "FAIL  curl missing"; _fail=1
  fi
  if command -v security >/dev/null 2>&1; then
    info "ok    macOS keychain (security) available"
  else
    info "note  'security' missing (keychain providers unavailable)"
  fi

  info ""
  if [ -n "${1:-}" ]; then
    status_one "$1"
  else
    for _n in $(provider_names); do status_one "$_n"; done
  fi
  return $_fail
}

cmd_start() {
  load_provider "$1"
  [ -n "$PRE_START" ] || { info "provider '$1' has no PRE_START hook."; return 0; }
  run_pre_start
}

cmd_stop() {
  load_provider "$1"
  run_post_stop
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
[ $# -ge 1 ] || { usage; exit 1; }
cmd=$1; shift

case $cmd in
  help|-h|--help) usage ;;
  version|-V|--version) info "claude-gateway $VERSION"; exit 0 ;;
  list)           cmd_list ;;
  status)         cmd_status "${1:-}" ;;
  doctor)         cmd_doctor "${1:-}" ;;
  start)          [ $# -ge 1 ] || die "usage: claude-gateway start <provider>"; cmd_start "$1" ;;
  stop)           [ $# -ge 1 ] || die "usage: claude-gateway stop <provider>";  cmd_stop "$1" ;;
  forget)         [ $# -ge 1 ] || die "usage: claude-gateway forget <provider>"; forget_last_model "$1"; info "forgot last model for provider '$1'" ;;
  run)            [ $# -ge 1 ] || die "usage: claude-gateway run <provider> [args...]"; cmd_run "$@" ;;
  *)              cmd_run "$cmd" "$@" ;;
esac
