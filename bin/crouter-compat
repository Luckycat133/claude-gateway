#!/bin/sh
# Shared backward-compatible launcher for the claude-<provider> shortcuts.
#
# Each compat name (claude-minimax, claude-antigravity, claude-antigravity-claude,
# claude-deepseek) is a symlink to this file. The provider is derived from the
# invoked name by stripping the "claude-" prefix, so there is no per-provider
# boilerplate to keep in sync.
set -u

# Capture the invoked name BEFORE resolving symlinks (its basename is the alias).
_orig=$(basename -- "$0")
PROVIDER=${_orig#claude-}

# Resolve this script's real directory (handles ~/.local/bin -> repo symlinks).
SELF=$0
while [ -h "$SELF" ]; do
  _d=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
  _l=$(readlink "$SELF")
  case $_l in
    /*) SELF=$_l ;;
    *)  SELF=$_d/$_l ;;
  esac
done
BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)

exec "$BIN_DIR/crouter" "$PROVIDER" "$@"
